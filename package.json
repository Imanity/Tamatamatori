{
  "name": "tamatamatori",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-maplibre.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run landmarks:verify && npm run formats:verify && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.mjs\"",
    "test:terrain": "node --experimental-strip-types --test tests/core/terrain.test.mjs tests/core/camera-calibration.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "update:orbits": "node --experimental-strip-types scripts/update-stations.mjs",
    "update:comets": "node --experimental-strip-types scripts/update-comets.mjs",
    "landmarks": "node scripts/landmarks.mjs",
    "landmarks:verify": "node scripts/landmarks.mjs verify",
    "formats": "node --experimental-strip-types scripts/formats.mjs",
    "formats:verify": "node --experimental-strip-types scripts/formats.mjs --check",
    "validate:alignment": "node --experimental-strip-types scripts/alignment-validation.mjs",
    "solve": "node --experimental-strip-types scripts/solve.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@jsquash/webp": "1.5.0",
    "@mapbox/vector-tile": "3.0.0",
    "@photostructure/tz-lookup": "11.7.0",
    "astronomy-engine": "2.1.19",
    "earcut": "3.2.4",
    "maplibre-gl": "6.16.0",
    "pbf": "5.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satellite.js": "7.1.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^27.4.0",
    "meshoptimizer": "1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
