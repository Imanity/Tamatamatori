{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imanity.github.io/Tamatamatori/solve.schema.json",
  "title": "Tamatamatori 推算请求 v1",
  "description": "求拍摄时间或机位的条件，由应用在本机推算。未知字段与不属于该求法的字段报错。说明见 https://imanity.github.io/Tamatamatori/solve-format.md",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "kind",
    "body"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "可写本 schema 的地址，读取时忽略"
    },
    "format": {
      "const": "tamatamatori.solve"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "maxLength": 40
    },
    "kind": {
      "enum": [
        "time",
        "position",
        "range"
      ],
      "description": "time 找时间（机位已定）；position 找机位（某一天）；range 两者都找（一段日期）"
    },
    "body": {
      "enum": [
        "sun",
        "moon",
        "galactic-center",
        "hyg-32263",
        "hyg-30365",
        "hyg-69451",
        "hyg-71456",
        "hyg-90979",
        "hyg-24549",
        "hyg-24378",
        "hyg-37173",
        "hyg-7574",
        "hyg-27919",
        "hyg-68483",
        "hyg-97338",
        "hyg-60530",
        "hyg-21368",
        "hyg-65269",
        "hyg-80519",
        "hyg-37718",
        "hyg-113008",
        "hyg-62239",
        "hyg-101767",
        "hyg-71453",
        "hyg-49528",
        "hyg-33492",
        "hyg-36744",
        "hyg-60893",
        "hyg-85665",
        "hyg-25273",
        "hyg-25364",
        "hyg-45106",
        "hyg-26246",
        "hyg-108922",
        "hyg-26662",
        "hyg-39840",
        "hyg-62757",
        "hyg-15824",
        "hyg-89906",
        "hyg-53905",
        "hyg-34354",
        "hyg-67088",
        "hyg-40921",
        "hyg-85965",
        "hyg-28288",
        "hyg-82022",
        "hyg-31601",
        "hyg-42794",
        "hyg-100425",
        "hyg-11734",
        "hyg-30251",
        "hyg-46259",
        "hyg-9861",
        "hyg-50440",
        "hyg-3413",
        "hyg-92564",
        "hyg-68714",
        "hyg-676",
        "hyg-5436",
        "hyg-27298",
        "hyg-72380",
        "hyg-111768",
        "hyg-85769",
        "hyg-14540",
        "hyg-9618",
        "hyg-57459",
        "hyg-4417",
        "hyg-61739",
        "hyg-39318",
        "hyg-45425",
        "hyg-76035",
        "hyg-44689",
        "hyg-65173",
        "hyg-100128",
        "hyg-3172",
        "hyg-87561",
        "hyg-25865",
        "hyg-744",
        "hyg-78165",
        "hyg-82144",
        "hyg-53754",
        "hyg-71879",
        "hyg-106972",
        "hyg-86403",
        "hyg-2076",
        "hyg-57828",
        "hyg-83755",
        "hyg-113521",
        "hyg-35806",
        "hyg-104861",
        "hyg-45809",
        "hyg-102157",
        "hyg-113603",
        "dso-ngc0224",
        "dso-ngc1976",
        "dso-mel022",
        "dso-ngc6523",
        "dso-ngc7000",
        "dso-ngc1499",
        "dso-ic1805",
        "dso-ic1848",
        "dso-ngc6514",
        "dso-ngc0598",
        "dso-ngc2237",
        "dso-ic0434",
        "dso-ngc2024",
        "dso-sh2-276",
        "dso-rhooph"
      ],
      "description": "\"sun\"、\"moon\"，或固定方向天体：\"galactic-center\"（银心）、亮星 hyg-…、深空目标 dso-…（见格式说明的列表）"
    },
    "mark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "azimuth",
        "elevation"
      ],
      "description": "天体中心的视方位与视高度（含所选折射），度",
      "properties": {
        "azimuth": {
          "type": "number",
          "description": "正北为 0、顺时针；取模归一"
        },
        "elevation": {
          "type": "number",
          "minimum": -0.25,
          "maximum": 89
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ],
      "description": "找时间的机位；缺省沿用打开者当前机位",
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "description": "纬度，北正南负"
        },
        "longitude": {
          "type": "number",
          "description": "经度，东正西负；超出 ±180 时取模归一"
        },
        "heightAboveGround": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100,
          "description": "相机离地高度，米"
        }
      }
    },
    "target": {
      "description": "地面目标：已接入地标的 id，或坐标",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "landmark"
          ],
          "properties": {
            "landmark": {
              "enum": [
                "big-ben",
                "burj-al-arab",
                "burj-khalifa",
                "chrysler-building",
                "cn-tower",
                "eiffel-tower",
                "empire-state-building",
                "lotte-world-tower",
                "metlife-building",
                "one-world-trade-center",
                "oriental-pearl",
                "osaka-castle",
                "petronas-towers",
                "shanghai-tower",
                "shanghai-wfc",
                "sydney-opera-house",
                "taipei-101",
                "three-world-trade-center",
                "tokyo-skytree",
                "tokyo-tower",
                "willis-tower"
              ]
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000,
              "description": "目标顶部高出 DEM 地面的米数；地标缺省为其高度，坐标缺省为 0"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "目标名称"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latitude",
            "longitude"
          ],
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90,
              "description": "纬度，北正南负"
            },
            "longitude": {
              "type": "number",
              "description": "经度，东正西负；超出 ±180 时取模归一"
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000,
              "description": "目标顶部高出 DEM 地面的米数；地标缺省为其高度，坐标缺省为 0"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "目标名称"
            }
          }
        }
      ]
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "当地日期（1900—2100 年）；缺省为打开者当前拍摄日期"
    },
    "days": {
      "type": "integer",
      "description": "跨度，天"
    },
    "timeZone": {
      "type": "string",
      "description": "IANA 时区；给出时日期按它解释，拍摄计划改为该固定时区"
    },
    "tolerance": {
      "enum": [
        0.1,
        0.25,
        0.5,
        1
      ],
      "default": 0.25,
      "description": "中心偏离期望位置的上限，视直径"
    },
    "share": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 0.5,
      "default": 0.3,
      "description": "主体占画面高度的比例（目标不足 10 m 时改用 maxDistance）"
    },
    "maxDistance": {
      "enum": [
        10000,
        20000,
        30000
      ],
      "default": 30000,
      "description": "机位离目标的最远距离，米"
    },
    "phase": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "enum": [
          0,
          0.1,
          0.25,
          0.5,
          0.75,
          0.9,
          1
        ]
      },
      "description": "月亮亮面比例 [下限, 上限]，下限不大于上限"
    },
    "sky": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "day",
          "golden",
          "blue",
          "twilight",
          "night"
        ]
      },
      "description": "天空条件（按太阳高度）"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "time"
          }
        }
      },
      "then": {
        "required": [
          "mark"
        ],
        "properties": {
          "days": {
            "enum": [
              30,
              90,
              365,
              1096
            ],
            "default": 365
          },
          "target": false,
          "share": false,
          "maxDistance": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "position"
          }
        }
      },
      "then": {
        "required": [
          "target"
        ],
        "properties": {
          "mark": false,
          "camera": false,
          "days": false,
          "tolerance": false,
          "share": false,
          "phase": false,
          "sky": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "range"
          }
        }
      },
      "then": {
        "required": [
          "target"
        ],
        "properties": {
          "days": {
            "enum": [
              7,
              30,
              90,
              365
            ],
            "default": 30
          },
          "mark": false,
          "camera": false,
          "tolerance": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "body": {
            "const": "sun"
          }
        }
      },
      "then": {
        "properties": {
          "phase": false,
          "sky": false
        }
      }
    },
    {
      "if": {
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "not": {
              "const": "moon"
            }
          }
        }
      },
      "then": {
        "properties": {
          "phase": false
        }
      }
    }
  ]
}
